Table users {
  id int [pk, increment]
  voornaam varchar(100)
  achternaam varchar(100)
  email varchar(150) [unique]
  wachtwoord varchar(255)
  telefoon varchar(20)
  rol varchar(50) // student, docent, mentor, commissie, admin
  actief boolean
  created_at timestamp
  updated_at timestamp
}

Table studenten {
  id int [pk, increment]
  user_id int [ref: - users.id]
  studentnummer varchar(20) [unique]
  opleiding varchar(100)
  academiejaar varchar(20)
  adres varchar(255)
  geboortedatum date
}

Table docenten {
  id int [pk, increment]
  user_id int [ref: - users.id]
  personeelsnummer varchar(20) [unique]
  departement varchar(100)
  specialisatie varchar(100)
}

Table commissieleden {
  id int [pk, increment]
  user_id int [ref: - users.id]
  functie varchar(100)
  departement varchar(100)
}

Table bedrijven {
  id int [pk, increment]
  naam varchar(150)
  adres varchar(255)
  postcode varchar(10)
  stad varchar(100)
  land varchar(100)
  sector varchar(100)
  btw_nummer varchar(50)
  website varchar(255)
  created_at timestamp
}

Table mentoren {
  id int [pk, increment]
  user_id int [ref: - users.id]
  bedrijf_id int [ref: > bedrijven.id]
  functie varchar(100)
  afdeling varchar(100)
}

Table stages {
  id int [pk, increment]
  student_id int [ref: > studenten.id]
  docent_id int [ref: > docenten.id]
  mentor_id int [ref: > mentoren.id]
  bedrijf_id int [ref: > bedrijven.id]
  titel varchar(255)
  opdracht text
  verwachte_resultaten text
  periode_start date
  periode_einde date
  aantal_dagen int
  werkadres varchar(255)
  status varchar(50) // ingediend, goedgekeurd, afgekeurd, aanpassingen_vereist, lopend, afgerond
  created_at timestamp
  updated_at timestamp
}

Table beoordelingen {
  id int [pk, increment]
  stage_id int [ref: > stages.id]
  commissielid_id int [ref: > commissieleden.id]
  beslissing varchar(50) // goedgekeurd, afgekeurd, aanpassingen_vereist
  feedback text
  intern_commentaar text
  datum timestamp
}

Table overeenkomsten {
  id int [pk, increment]
  stage_id int [ref: - stages.id]
  bestandsnaam varchar(255)
  bestandspad varchar(500)
  bestandstype varchar(50)
  upload_datum timestamp
  ondertekend_student boolean
  ondertekend_mentor boolean
  ondertekend_school boolean
  geldig_vanaf date
  geldig_tot date
}

Table logboeken {
  id int [pk, increment]
  stage_id int [ref: > stages.id]
  week_nummer int
  datum_van date
  datum_tot date
  taken text
  reflectie text
  leerpunten text
  problemen text
  uren_gewerkt float
  afgetekend boolean
  afgetekend_door int [ref: > users.id]
  afgetekend_op timestamp
  created_at timestamp
}

Table competentie_profielen {
  id int [pk, increment]
  naam varchar(150)
  omschrijving text
  opleiding varchar(100)
  academiejaar varchar(20)
  actief boolean
  created_at timestamp
}

Table competenties {
  id int [pk, increment]
  profiel_id int [ref: > competentie_profielen.id]
  naam varchar(150)
  omschrijving text
  gewicht float
  min_score float
  max_score float
  volgorde int
  actief boolean
  created_at timestamp
  updated_at timestamp
}

Table evaluaties {
  id int [pk, increment]
  stage_id int [ref: > stages.id]
  competentie_id int [ref: > competenties.id]
  beoordelaar_id int [ref: > users.id]
  score float
  beschrijving_student text
  feedback_docent text
  feedback_mentor text
  type varchar(50) // tussentijds, finaal
  datum date
  created_at timestamp
}

Table tussentijdse_besprekingen {
  id int [pk, increment]
  stage_id int [ref: > stages.id]
  docent_id int [ref: > docenten.id]
  mentor_id int [ref: > mentoren.id]
  datum date
  locatie varchar(255)
  samenvatting text
  actiepunten text
  algemene_score float
  volgende_bespreking date
  created_at timestamp
}

Table eindpresentaties {
  id int [pk, increment]
  stage_id int [ref: - stages.id]
  datum date
  locatie varchar(255)
  aanvangstijd time
  eindtijd time
  jury_leden text
  finale_score float
  sterktes text
  verbeterpunten text
  opmerkingen text
  created_at timestamp
}

Table documenten {
  id int [pk, increment]
  stage_id int [ref: > stages.id]
  uploader_id int [ref: > users.id]
  naam varchar(255)
  bestandspad varchar(500)
  bestandstype varchar(50)
  categorie varchar(100) // overeenkomst, evaluatie, logboek, overig
  upload_datum timestamp
}

Table notificaties {
  id int [pk, increment]
  user_id int [ref: > users.id]
  titel varchar(255)
  bericht text
  type varchar(50) // info, waarschuwing, actie_vereist
  gelezen boolean
  created_at timestamp
}
